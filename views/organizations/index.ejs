<h4>Organizations <a class="btn btn-secondary btn-sm" href="/organizations/new">Add</a></h4>
<%- include('../partials/list-controls.ejs') %>

<table class="table">
  <caption>List of organizations</caption>
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col"><a href="<%= sortHref('name') %>">Name</a></th>
      <th class="d-none d-sm-table-cell" scope="col"><a href="<%= sortHref('description') %>">Description</a></th>
      <th scope="col"></th>
      <th scope="col"></th>
    </tr>
  </thead>
  <tbody>
    <% for( let i = 1; i <= organizations.length; i++ ) { 
      organization = organizations[i-1];
    %>        
    <tr>
      <th scope="row"><%= list.start + i %></th>
      <td>
        <a href="/organizations/<%=organization._id%>">
          <%=organization.name%>
        </a>
      </td>
      <td class="d-none d-sm-table-cell">
        <%=organization.description%>
      </td> 
      <td>
        <a class="btn btn-secondary btn-sm" href="/organizations/<%=organization._id%>/edit">
          Edit
        </a>
      </td>
      <td>
        <form action="/organizations/<%=organization._id%>?_method=DELETE" method="POST">
          <input type="submit" class="btn btn-danger btn-sm" value="DELETE">
        </form>
      </td>
    </tr>
    <% } %>

  </tbody>
</table>
  